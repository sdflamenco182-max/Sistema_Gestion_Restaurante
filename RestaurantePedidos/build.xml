<?xml version="1.0" encoding="UTF-8"?>
<project name="RestaurantePedidos" default="default" basedir=".">
    <description>Compila y ejecuta el proyecto RestaurantePedidos.</description>
    <import file="nbproject/build-impl.xml"/>

    <target name="-post-jar">
        <copy todir="${dist.dir}/lib">
            <fileset dir="lib"/>
        </copy>
        <manifestclasspath property="jar.classpath.lib" jarfile="${dist.jar}">
            <classpath>
                <fileset dir="${dist.dir}/lib" includes="*.jar"/>
            </classpath>
        </manifestclasspath>
        <jar update="true" destfile="${dist.jar}">
            <manifest>
                <attribute name="Class-Path" value="${jar.classpath.lib}"/>
            </manifest>
        </jar>
    </target>
</project>
