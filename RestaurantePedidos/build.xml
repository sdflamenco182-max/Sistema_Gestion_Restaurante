<?xml version="1.0" encoding="UTF-8"?>
<project name="RestaurantePedidos" default="default" basedir=".">
    <description>Compila, prueba y ejecuta el proyecto RestaurantePedidos.</description>
    <import file="nbproject/build-impl.xml"/>

    <!-- Copia las librerias a dist/lib y las enlaza en el JAR, para que "java -jar dist/RestaurantePedidos.jar" funcione -->
    <target name="-post-jar">
        <copy todir="${dist.dir}/lib">
            <fileset dir="lib"/>
        </copy>
        <manifestclasspath property="jar.classpath.lib" jarfile="${dist.jar}">
            <classpath>
                <fileset dir="${dist.dir}/lib" includes="*.jar"/>
            </classpath>
        </manifestclasspath>
        <jar update="true" destfile="${dist.jar}">
            <manifest>
                <attribute name="Class-Path" value="${jar.classpath.lib}"/>
            </manifest>
        </jar>
    </target>

    <!-- Ejecuta las pruebas unitarias JUnit 5: ant probar -->
    <target name="probar" depends="compile-test" description="Ejecuta las pruebas unitarias (JUnit 5)">
        <java classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true">
            <classpath>
                <pathelement path="${run.test.classpath}"/>
            </classpath>
            <arg value="execute"/>
            <arg value="--scan-classpath"/>
            <arg value="${build.test.classes.dir}"/>
            <arg value="--details=summary"/>
            <arg value="--disable-banner"/>
        </java>
    </target>
</project>
