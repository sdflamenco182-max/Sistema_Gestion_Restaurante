# Plantilla de configuración de MongoDB (sin credenciales reales).
# Copie este archivo como "mongodb.properties" junto al JAR (o en la raíz del proyecto
# al ejecutar desde NetBeans) y ajuste los valores. Si el archivo no existe se usan
# los valores por defecto indicados abajo.
#
# También se puede definir la variable de entorno MONGODB_URI, que tiene prioridad.

# Instalación local sin autenticación (valor por defecto)
mongodb.uri=mongodb://localhost:27017
# Ejemplo con autenticación (reemplace con sus propios datos):
# mongodb.uri=mongodb://USUARIO:CLAVE@localhost:27017/?authSource=admin

mongodb.database=restaurante_db
